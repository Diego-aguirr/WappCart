# Database — points to containerized postgres
DATABASE_URL="postgresql://user:password@db:5432/wappcart"

# WhatsApp
WHATSAPP_NUMBER=your_country_code_phone

# Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_password
ADMIN_PEPPER=your_64_char_hex

# Cookie — override secure flag for local TLS-less dev
COOKIE_SECURE=false
